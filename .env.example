# ---- Analitika: saqlash (Upstash Redis / Vercel KV) ----
# Vercel Marketplace orqali Upstash ulansa, ba'zi hollarda KV_* nomlari keladi.
# Ikkala variant ham qo'llab-quvvatlanadi.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ---- Gmail orqali hisobot ----
# Oddiy Gmail paroli emas, 16 belgili App Password ishlatiladi.
GMAIL_USER="your.address@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
REPORT_TO="your.address@gmail.com"

# ---- Dashboard himoyasi ----
# Uzun tasodifiy qiymatlar qo'ying (masalan: openssl rand -hex 24).
REPORT_KEY="change-me-long-random-key"
CRON_SECRET="change-me-another-long-random-key"

# ---- Ixtiyoriy ----
# Kunlik hisobot vaqti UTC bo'yicha 05:00 = Toshkentda 10:00 (vercel.json).
# Mahalliy vaqt hisobi uchun ofset (soat):
ANALYTICS_TZ_OFFSET="5"
# Email va dashboarddagi havola uchun:
SITE_URL="https://sahobalar.vercel.app"
